# マップ集客ラボ レベルチェッカー — 環境変数（本番は Vercel の Environment Variables に設定）

# 【必須】管理者ボードへ入るための管理者トークン（初期アカウントリンクの元）。
# 長いランダム文字列にすること。生成例:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-admin-token

# 【任意】アカウントリンク/Cookie 署名用のシークレット。
SERVER_SECRET=change-me-to-a-long-random-string

# 【必須・診断/営業データの保存に使用】Upstash/Vercel Redis の接続URL（TCP）。
# 未設定でもビルドは通るが、データは保存されない（メモリfallback）。
# 例: rediss://default:xxxxx@yyyy.upstash.io:6379
REDIS_URL=

# 【任意】診断結果に表示する LINE 友だち追加URL（管理画面でも設定可）。
LINE_ADD_URL=
